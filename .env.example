# Base URL of your Karakeep instance (without /api/v1)
KARAKEEP_URL=https://karakeep.example.lan
# Karakeep → Settings → API Keys
KARAKEEP_API_KEY=ak1_...
# Optional: require HTTP basic auth (any user name, this password)
TAGGER_PASSWORD=
# Optional: parallel Karakeep requests for bulk tagging (default 8)
# TAGGER_CONCURRENCY=8

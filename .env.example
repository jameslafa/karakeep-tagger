# Base URL of your Karakeep instance (without /api/v1)
KARAKEEP_URL=https://karakeep.example.lan
# Karakeep → Settings → API Keys
KARAKEEP_API_KEY=ak1_...
# Host names you open the app by, besides localhost (comma-separated, no port).
# Requests for any other host are refused (protects against DNS rebinding).
TAGGER_HOSTS=tagger.example.lan
# Optional: require HTTP basic auth (any user name, this password)
TAGGER_PASSWORD=
# Optional (Docker Compose): host address and port to publish on (default 127.0.0.1:8080,
# reachable only from this machine). Use 0.0.0.0:8080 to allow other devices on your network.
# TAGGER_PUBLISH=127.0.0.1:8080
# Optional: parallel Karakeep requests for bulk tagging (default 8)
# TAGGER_CONCURRENCY=8

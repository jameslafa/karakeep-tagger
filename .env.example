# Base URL of your Karakeep instance (without /api/v1)
KARAKEEP_URL=https://karakeep.example.lan
# Karakeep → Settings → API Keys
KARAKEEP_API_KEY=ak1_...
# Host names you open the app by, besides localhost (comma-separated, no port).
# Requests for any other host are refused (protects against DNS rebinding).
TAGGER_HOSTS=tagger.example.lan
# Optional: require HTTP basic auth (any user name, this password)
TAGGER_PASSWORD=
# Optional (Docker Compose): host address and port to publish on (default 127.0.0.1:8080,
# reachable only from this machine). Use 0.0.0.0:8080 to allow other devices on your network.
# TAGGER_PUBLISH=127.0.0.1:8080
# Optional: parallel Karakeep requests for bulk tagging (default 8)
# TAGGER_CONCURRENCY=8

# ---- Inbox import (optional): import images dropped into a Seafile library ----
# Seafile base URL as reached from the container. With Docker on the same machine,
# host.docker.internal plus the port Seafile is published on works without Tailscale.
# SEAFILE_URL=http://host.docker.internal:8000
# Library-scoped API token (Seafile: library → … → API Token, read-write permission)
# SEAFILE_TOKEN=
# Folders in that library and the Karakeep list each one imports into. Files in the
# library root, hidden files and other folders are ignored.
# INBOX_FOLDERS=photography=Photography,ropes=Ropes
# Optional tag added to every imported image (none by default)
# INBOX_TAG=
# INBOX_POLL_SECONDS=60
# Log what would be imported and deleted without changing anything
# INBOX_DRY_RUN=false
# Optional separate Karakeep API key for the importer (default: KARAKEEP_API_KEY)
# KARAKEEP_INBOX_API_KEY=
